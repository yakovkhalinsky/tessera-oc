diff --git a/parts/oc_ui_overview.c b/parts/oc_ui_overview.c
new file mode 100644
index 0000000..4950872
--- /dev/null
+++ b/parts/oc_ui_overview.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Yakov Khalinsky */
+/* OVERVIEW's lanes (UI-PLAN.md §4.1, phase 3). */
+#include <stdio.h>
+#include <string.h>
+
+#include "oc_ui_overview.h"
+
+static const char *const NOTE_NAME[12] = {
+    "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};
+
+void ui_note_text(int16_t midi, char *out, uint32_t n)
+{
+    int32_t v, oct;
+    if (!out || !n)
+        return;
+    out[0] = 0;
+    if (midi < 0) {
+        (void)snprintf(out, n, "--");
+        return;
+    }
+    v = midi;
+    if (v > 120)
+        v = 120;
+    oct = (v / 12) - 1;             /* MIDI 36 = C2 */
+    (void)snprintf(out, n, "%s%d", NOTE_NAME[v % 12], (int)oct);
+}
+
+uint16_t ui_hist_shift(uint16_t hist, int on)
+{
+    return (uint16_t)((hist << 1) | (on ? 1u : 0u));
+}
+
+/* the header: the transport, the tempo or "---", the clock, the track,
+ * and OVERVIEW, knocked out of the lit bar */
+static void ui_ov_header(oc_gfx_t *g, const ui_overview_t *o)
+{
+    char title[32];
+    unsigned tr = (unsigned)((o->sel % UI_LANES) + 1u);
+    if (o->ext)
+        snprintf(title, sizeof title, "%c --- EXT T%u OVERVIEW", o->playing ? '>' : ' ', tr);
+    else
+        snprintf(title, sizeof title, "%c %3d INT T%u OVERVIEW", o->playing ? '>' : ' ',
+                 (int)o->tempo, tr);
+    oc_gfx_text5x7(g, 2, UI_HDR_TEXT_Y, title);
+    oc_gfx_invert_rect(g, 0, UI_HDR_Y, UI_FB_W, UI_HDR_H);
+}
+
+/* the ROLL flag: a wave five pixels wide and three tall (the 5 x 7 face has
+ * no ~, and the 3 x 5 one is too small to read beside the 5 x 7 text) */
+static void ui_ov_tilde(oc_gfx_t *g, int16_t x, int16_t y)
+{
+    oc_gfx_px(g, (int16_t)(x + 1), y, 1);
+    oc_gfx_px(g, (int16_t)(x + 2), y, 1);
+    oc_gfx_px(g, x, (int16_t)(y + 1), 1);
+    oc_gfx_px(g, (int16_t)(x + 3), (int16_t)(y + 1), 1);
+    oc_gfx_px(g, (int16_t)(x + 3), (int16_t)(y + 2), 1);
+    oc_gfx_px(g, (int16_t)(x + 4), (int16_t)(y + 2), 1);
+}
+
+/* one lane: the track number, the generator, the note, M/~ and the strip */
+static void ui_ov_lane(oc_gfx_t *g, uint32_t i, const ui_lane_t *l, int selected)
+{
+    int16_t y = (int16_t)(UI_BODY_Y + (int32_t)i * UI_LANE_H);
+    int16_t ty = (int16_t)(y + 2);
+    char num[2];
+    uint32_t b, x;
+
+    num[0] = (char)('1' + (int)i);
+    num[1] = 0;
+    oc_gfx_text5x7(g, 2, ty, num);
+    oc_gfx_text5x7(g, 12, ty, l->gen[0] ? l->gen : "?");
+    oc_gfx_text5x7(g, 52, ty, l->note[0] ? l->note : "--");
+    if (l->muted)
+        oc_gfx_text5x7(g, 72, ty, "M");
+    else if (l->roll)
+        ui_ov_tilde(g, 72, (int16_t)(ty + 2));
+
+    /* 16 cells at the right: 2 pixels wide, 1 pixel between, 7 tall.
+     * A sounding cell is filled; an empty one is a 2-pixel tick at the foot.
+     * A muted lane keeps the cells empty. */
+    x = 81u;
+    for (b = 0; b < UI_HIST_BITS; b++) {
+        int on = !l->muted && (l->hist & (uint16_t)(1u << (UI_HIST_BITS - 1u - b)));
+        if (on)
+            oc_gfx_fill_rect(g, (int16_t)x, ty, 2, UI_CH_H, 1);
+        else
+            oc_gfx_fill_rect(g, (int16_t)x, (int16_t)(ty + UI_CH_H - 1), 2, 1, 1);
+        x += 3u;
+    }
+    if (selected)
+        oc_gfx_invert_rect(g, 0, y, UI_FB_W, UI_LANE_H);
+}
+
+void ui_overview_draw(oc_gfx_t *g, const ui_overview_t *o)
+{
+    uint32_t i;
+    oc_gfx_clear(g);
+    if (!o)
+        return;
+    ui_ov_header(g, o);
+    for (i = 0; i < UI_LANES; i++)
+        ui_ov_lane(g, i, &o->lane[i], o->sel == i);
+    if (o->footer)
+        oc_gfx_text3x5(g, 2, UI_FTR_TEXT_Y, o->footer);
+}
diff --git a/parts/oc_ui_overview.h b/parts/oc_ui_overview.h
new file mode 100644
index 0000000..249a1af
--- /dev/null
+++ b/parts/oc_ui_overview.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Yakov Khalinsky */
+/* OVERVIEW's lanes (UI-PLAN.md §4.1, phase 3): the note name, the gate
+ * history and the four-lane screen, pure C so the host can check them. */
+#ifndef OC_UI_OVERVIEW_H_
+#define OC_UI_OVERVIEW_H_
+
+#include <stdint.h>
+#include "oc_ui_gfx.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define UI_LANES 4u
+#define UI_LANE_H 11                /* four lanes and three 0-pixel gaps fill the body */
+#define UI_HIST_BITS 16u
+
+/* a lane, as the shell describes it */
+typedef struct {
+    char gen[8];                    /* the engine's own name (oc_tx_desc, TX_MODE) */
+    char note[6];                   /* "C2", "D#3", or "--" if there is none */
+    uint16_t hist;                  /* 16 cells, bit 0 is the newest (the right) */
+    uint8_t muted;                  /* 1: show M and an empty strip */
+    uint8_t roll;                   /* 1: a ROLL is waiting for the next bar (~) */
+} ui_lane_t;
+
+/* the OVERVIEW screen: the header's transport and the four lanes */
+typedef struct {
+    uint8_t playing;
+    uint8_t ext;                    /* 1: the clock follows TR1; the tempo is "---" */
+    uint8_t sel;                    /* the selected track, 0..3 */
+    int16_t tempo;
+    ui_lane_t lane[UI_LANES];
+    const char *footer;
+} ui_overview_t;
+
+/* the current note, as text: MIDI 36 is C2 (the CV's 0 V). -1 is "--".
+ * Below 0 or above 120 is clamped (the CV's span is MIDI 0..120). */
+void ui_note_text(int16_t midi, char *out, uint32_t n);
+
+/* one frame of the history: the new bit goes in on the right, the oldest
+ * falls off the left. */
+uint16_t ui_hist_shift(uint16_t hist, int on);
+
+/* the OVERVIEW screen, drawn on the grid: the header bar, four 11-pixel
+ * lanes (the selected one inverted), the 16-cell strip, the footer. */
+void ui_overview_draw(oc_gfx_t *g, const ui_overview_t *o);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/parts/oc_view.c b/parts/oc_view.c
index c7d8ffe..6b2c8b7 100644
--- a/parts/oc_view.c
+++ b/parts/oc_view.c
@@ -176,3 +176,41 @@ void oc_set_generator(uint32_t tr, int32_t mode)
         mode = 13;
     tessera_param_set(tr, TX_MODE, mode);
 }
+
+void oc_gen_label(uint32_t gen, char *buf, uint32_t n)
+{
+    const param_desc_t *d = oc_tx_desc(TX_MODE);
+    uint32_t i = 0;
+    const char *name;
+    if (!buf || !n)
+        return;
+    if (d && d->names && gen <= (uint32_t)d->max && d->names[gen])
+        name = d->names[gen];
+    else
+        name = "?";
+    for (; i + 1u < n && name[i]; i++)
+        buf[i] = name[i];
+    buf[i] = 0;
+}
+
+int oc_track_muted(uint32_t tr)
+{
+    return tr < NTRK && trk[tr].p[P_MUTE] != 0;
+}
+
+void oc_track_set_mute(uint32_t tr, int on)
+{
+    if (tr < NTRK)
+        oc_track_param_set(tr, P_MUTE, on ? 1 : 0);
+}
+
+int oc_track_roll_pending(uint32_t tr)
+{
+    return tr < TESSERA_TRACKS && tessera.roll[tr] != 0;
+}
+
+void oc_track_set_roll(uint32_t tr, uint16_t v)
+{
+    if (tr < TESSERA_TRACKS)
+        tessera.roll[tr] = v;
+}
diff --git a/tests/oc_ui_overview_test.c b/tests/oc_ui_overview_test.c
new file mode 100644
index 0000000..82137e8
--- /dev/null
+++ b/tests/oc_ui_overview_test.c
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Yakov Khalinsky */
+/* OVERVIEW's helpers: the note name and the gate history (UI-PLAN §4.1). */
+#include <stdio.h>
+#include <string.h>
+#include "oc_ui_overview.h"
+
+static int checks, failures;
+
+static void check(const char *what, int ok)
+{
+    checks++;
+    if (!ok)
+        failures++;
+    printf("oc_overview: %-72s %s\n", what, ok ? "ok" : "FAIL");
+}
+
+static void check_note(void)
+{
+    char b[8];
+    ui_note_text(36, b, sizeof b);
+    check("note: MIDI 36 is C2 (the CV's 0 V)", strcmp(b, "C2") == 0);
+    ui_note_text(51, b, sizeof b);
+    check("note: MIDI 51 is D#3", strcmp(b, "D#3") == 0);
+    ui_note_text(0, b, sizeof b);
+    check("note: MIDI 0 is C-1", strcmp(b, "C-1") == 0);
+    ui_note_text(-1, b, sizeof b);
+    check("note: none is --", strcmp(b, "--") == 0);
+    ui_note_text(-20, b, sizeof b);
+    check("note: below none is still --", strcmp(b, "--") == 0);
+    ui_note_text(120, b, sizeof b);
+    check("note: MIDI 120 is C9, the top of the CV", strcmp(b, "C9") == 0);
+    ui_note_text(127, b, sizeof b);
+    check("note: above 120 clamps to C9", strcmp(b, "C9") == 0);
+    ui_note_text(60, b, 0);
+    check("note: a zero buffer is left alone", 1);
+}
+
+static void check_hist(void)
+{
+    uint16_t h = 0;
+    int i;
+    h = ui_hist_shift(h, 1);
+    check("hist: the first bit lands on the right", h == 1u);
+    h = ui_hist_shift(h, 0);
+    check("hist: a silent frame shifts a zero in", h == 2u);
+    for (i = 0; i < 14; i++)
+        h = ui_hist_shift(h, 1);
+    check("hist: 16 cells, the oldest still there", h == 0xBFFFu);
+    h = ui_hist_shift(h, 0);
+    check("hist: the 17th frame drops the oldest bit", h == 0x7FFEu);
+}
+
+int main(void)
+{
+    check_note();
+    check_hist();
+    printf("oc_overview: %d checks, %d failing\n", checks, failures);
+    return failures ? 1 : 0;
+}
